<% attention = rows.select { |item| @activities[item.id].needs_you? }; progress = rows.select { |item| @activities[item.id].group == "progress" }; idle = rows.select { |item| @activities[item.id].group == "idle" }; history = rows.select { |item| @activities[item.id].group == "history" }.sort_by { |item| [-(item.source_updated_at || Time.at(0)).to_f, -item.id] } %>
<% if source == "claude" %><p class="group-description" role="status">Desktop open / archived list unavailable. Refresh reads saved history; it cannot synchronize Desktop archive changes. Fresh lifecycle observations and saved history are shown separately.</p><% end %>
<% if attention.any? %><h3 class="group-heading">Needs you · <%= attention.size %></h3><%= render partial: "item", collection: attention, locals: {source: source, state: state} %><% end %>
<% if progress.any? %><h3 class="group-heading">Working / waiting · <%= progress.size %></h3><%= render partial: "item", collection: progress, locals: {source: source, state: state} %><% end %>
<% if idle.any? %><div class="observed-conversations"><h3 class="group-heading">Recently observed · response stopped · <%= idle.size %></h3><p class="group-description">A fresh lifecycle signal indicates the response is idle. Open / archived state and task completion remain unknown.</p><%= render partial: "item", collection: idle, locals: {source: source, state: state} %></div><% end %>
<% if rows.any? && attention.empty? && progress.empty? && idle.empty? %><p class="group-description">No sessions have fresh verified activity. This does not confirm that no sessions are open.</p><% end %>
<% if history.any? %><details class="history-group"><summary>Imported history · live state unknown · <%= history.size %></summary><p class="group-description">Saved conversations retained for reference. Inclusion here does not mean open, archived or completed.</p><%= render partial: "item", collection: history, locals: {source: source, state: state} %></details><% end %>
